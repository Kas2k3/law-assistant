# Copy this file to `.env` and fill in the real values.
# Never commit `.env` — it is gitignored on purpose.

# ----- OpenAI (required) -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_AGENT_MODEL=gpt-4o-mini

# ----- Agentic RAG tuning (optional) -----
AGENT_LLM_MAX_NOIDUNG_CHARS=4000
AGENT_LLM_MAX_PASSAGE_CHARS=4000
AGENT_VECTOR_POOL_MULT=3
RAG_AGENT_LLM_RERANK=0
# Ngưỡng cosine similarity để đánh dấu một câu trong câu trả lời là "nghi bịa" (0..1)
AGENT_GROUNDING_THRESHOLD=0.35
# Cache kết quả vector_search theo (query, top_k) để tránh gọi lại OpenAI embedding
RAG_CACHE_ENABLED=1

# ----- MySQL (matches law-crawler/docker-compose.yml defaults) -----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456789
MYSQL_DATABASE=law

# ----- Neo4j (matches infra/docker-compose.yml defaults) -----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ----- Tavily web search (optional — web_search tool disabled if empty) -----
TAVILY_API_KEY=

# ----- Chat history (optional — falls back to SQLite/JSON/in-memory if empty) -----
MONGODB_URI=
MONGODB_DB=chatbot_rag
MONGODB_COLLECTION=conversations

# ----- Langfuse tracing/observability (optional — tắt nếu để trống, không lỗi) -----
# Lấy tại: https://cloud.langfuse.com → Project → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # hoặc https://us.cloud.langfuse.com nếu project tạo ở region US

