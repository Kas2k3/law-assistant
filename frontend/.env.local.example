# Copy this file to `.env.local` and adjust if needed.
# Never commit `.env.local` — it is gitignored on purpose.

# Chỉ gốc host:port — route API tự nối /rag/stream, /rag/chat, /tts, /stt
RAG_BACKEND_URL=http://127.0.0.1:8001

# Tùy chọn — không có thì lịch sử chat lưu trong RAM (mất khi restart dev server)
MONGODB_URI=
MONGODB_DB=chatbot_rag
MONGODB_COLLECTION=conversations
